19. Remove Nth Node From End of List
https://leetcode.com/problems/remove-nth-node-from-end-of-list/

--Solution: 1
    /**
     * Definition for singly-linked list.
     * public class ListNode {
     * int val;
     * ListNode next;
     * ListNode(int x) { val = x; }
     * }
     */
    class Solution {
        public ListNode removeNthFromEnd(ListNode head, int n) {

            ListNode node = head;
            int len = 0;

            /* Find the size of list by walking through entire list. */
            while (node != null) {
                len++;
                node = node.next;
            }

            /* When Nth node is head of the list. */
            if (n == len) {
                return head.next;
            } else {
                /* Find the node which is just before the Nth node. */
                node = head;
                for (int i = 1; i <= len - n - 1; i++) {
                    node = node.next;
                }
            }

            /* Remove the Nth node. */
            node.next = node.next.next;

            return head;
        }
    }
