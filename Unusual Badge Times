/*
To solve this problem, you can use the following Python function. 
This function will iterate through the given list of badge times, keep track of the employees' access times, and 
identify the employees who have badged into the room three or more times within a one-hour period. 
It will return a dictionary where the keys are employee names, and the values are lists of access times within the suspicious one-hour periods.
*/

def find_unusual_badge_times(badge_times):
    employee_access = {}  # Dictionary to store employee access times

    for name, time_str in badge_times:
        if name not in employee_access:
            employee_access[name] = []

        # Convert time string to minutes since midnight
        hours, minutes = int(time_str) // 100, int(time_str) % 100
        total_minutes = hours * 60 + minutes

        # Check if employee has previous access times
        if len(employee_access[name]) >= 2:
            # Calculate time difference between current and previous accesses
            diff1 = total_minutes - employee_access[name][-1]
            diff2 = total_minutes - employee_access[name][-2]

            # Check if either time difference is within one hour (<= 60 minutes)
            if diff1 <= 60 or diff2 <= 60:
                employee_access[name].append(total_minutes)
            else:
                employee_access[name] = [total_minutes]
        else:
            employee_access[name].append(total_minutes)

    # Filter employees with three or more accesses in a one-hour period
    unusual_employees = {}
    for name, access_times in employee_access.items():
        if len(access_times) >= 3:
            unusual_employees[name] = access_times[:3]

    return unusual_employees

badge_times = [
